{
  "manifest_version": 3,
  "name": "opensteamer Media",
  "version": "1.0.0",
  "description": "Share current YouTube media and narrowly scoped playback controls with opensteamer.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["nativeMessaging", "scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["adapter.js"], "run_at": "document_start", "world": "MAIN", "all_frames": false },
    { "matches": ["https://www.youtube.com/*"], "js": ["bridge.js"], "run_at": "document_start", "world": "ISOLATED", "all_frames": false }
  ]
}
