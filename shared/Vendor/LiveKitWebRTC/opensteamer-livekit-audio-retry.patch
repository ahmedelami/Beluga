+bool ObjCAudioDeviceModule::RetryPlayout(
+    id<RTC_OBJC_TYPE(RTCAudioDevice)> audio_device,
+    id<RTC_OBJC_TYPE(RTCAudioDeviceDelegate)> delegate) {
+  RTC_DCHECK_RUN_ON(&thread_checker_);
+  const auto owns_device = [&] {
+    return audio_device != nil && audio_device == audio_device_ &&
+           delegate != nil && delegate == audio_device_delegate_ &&
+           Initialized();
+  };
+  if (!owns_device()) {
+    return false;
+  }
+  if (playing_.load() && ![audio_device_ isPlaying]) {
+    // A native policy rebuild may stop output without passing through ADM Stop.
+    // Retire only the stale playout side before re-entering InitPlayout.
+    playing_.store(false, std::memory_order_release);
+    audio_device_buffer_->StopPlayout();
+  }
+  if (playing_.load() && !PlayoutIsInitialized()) {
+    return false;
+  }
+  if (InitPlayout() != 0 || !owns_device() ||
+      !PlayoutIsInitialized()) {
+    return false;
+  }
+  if (StartPlayout() != 0 || !owns_device()) {
+    return false;
+  }
+  if (PlayoutIsInitialized() && Playing() &&
+      audio_device_buffer_->IsPlaying()) {
+    return true;
+  }
+  playing_.store(false, std::memory_order_release);
+  audio_device_buffer_->StopPlayout();
+  return false;
+}
