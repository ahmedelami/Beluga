+@interface RTCCustomAudioDeviceRetryTests : XCTestCase {
+  std::unique_ptr<webrtc::Thread> _worker;
+  webrtc::scoped_refptr<ObjCAudioDeviceModule> _module;
+  std::unique_ptr<RetryTestAudioTransport> _transport;
+  RTCRetryTestAudioDevice* _device;
+}
+@end
+
+@implementation RTCCustomAudioDeviceRetryTests
+
+- (void)setUp {
+  [super setUp];
+  _worker = webrtc::Thread::Create();
+  XCTAssertTrue(_worker->Start());
+  _device = [[RTCRetryTestAudioDevice alloc] init];
+  _transport = std::make_unique<RetryTestAudioTransport>();
+  _worker->BlockingCall([&] {
+    _module = webrtc::make_ref_counted<ObjCAudioDeviceModule>(
+        webrtc::CreateEnvironment(), _device);
+    XCTAssertEqual(_module->Init(), 0);
+    XCTAssertEqual(_module->RegisterAudioCallback(_transport.get()), 0);
+  });
+}
+
+- (void)tearDown {
+  _worker->BlockingCall([&] {
+    _module->StopPlayout();
+    _module->StopRecording();
+    _module->Terminate();
+    _module = nullptr;
+  });
+  _worker->Stop();
+  _worker.reset();
+  _transport.reset();
+  _device = nil;
+  [super tearDown];
+}
+
+- (void)assertPlayoutSamples:(int16_t)value silence:(BOOL)silence {
+  std::array<int16_t, 960> samples;
+  samples.fill(-1);
+  AudioBufferList buffers = {};
+  buffers.mNumberBuffers = 1;
+  buffers.mBuffers[0].mNumberChannels = 2;
+  buffers.mBuffers[0].mDataByteSize = sizeof(samples);
+  buffers.mBuffers[0].mData = samples.data();
+  AudioTimeStamp timestamp = {};
+  AudioUnitRenderActionFlags flags = 0;
+  XCTAssertEqual(_device.delegate.getPlayoutData(&flags, &timestamp, 0, 480,
+                                                &buffers), noErr);
+  XCTAssertEqual((flags & kAudioUnitRenderAction_OutputIsSilence) != 0, silence);
+  XCTAssertTrue(std::all_of(samples.begin(), samples.end(),
+                            [value](int16_t sample) { return sample == value; }));
+}
+
+- (void)testInitialFailureRetriesActualWrapperAndProducesTransportPCM {
+  _worker->BlockingCall([&] {
+    _device.initializationFailures = 1;
+    XCTAssertEqual(_module->InitPlayout(), -1);
+    XCTAssertFalse(_module->PlayoutIsInitialized());
+    XCTAssertFalse(_module->Playing());
+    XCTAssertFalse(ObjCAudioDeviceModuleRetryTestPeer::BufferPlaying(_module.get()));
+    XCTAssertEqual(_device.playoutStarts, 0u);
+    [self assertPlayoutSamples:0 silence:YES];
+    XCTAssertEqual(_transport->playout_calls, 0u);
+
+    XCTAssertTrue([_device.delegate retryPlayoutForAudioDevice:_device]);
+    XCTAssertTrue(_module->PlayoutIsInitialized());
+    XCTAssertTrue(_module->Playing());
+    XCTAssertTrue(ObjCAudioDeviceModuleRetryTestPeer::BufferPlaying(_module.get()));
+    XCTAssertEqual(_device.playoutInitializations, 2u);
+    XCTAssertEqual(_device.playoutStarts, 1u);
+    [self assertPlayoutSamples:1234 silence:NO];
