+class RetryTestAudioTransport final : public webrtc::AudioTransport {
+ public:
+  size_t playout_calls = 0;
+
+  int32_t NeedMorePlayData(size_t samples, size_t,
+                          size_t channels, uint32_t, void* output,
+                          size_t& samples_out, int64_t* elapsed_time_ms,
+                          int64_t* ntp_time_ms) override {
+    ++playout_calls;
+    std::fill_n(static_cast<int16_t*>(output), samples * channels, 1234);
+    // AudioTransport reports total interleaved samples; AudioDeviceBuffer
+    // divides by channels before validating the requested per-channel frames.
+    samples_out = samples * channels;
+    *elapsed_time_ms = 0;
+    *ntp_time_ms = 0;
+    return 0;
+  }
+
+  int32_t RecordedDataIsAvailable(const void*, size_t, size_t, size_t, uint32_t,
+                                 uint32_t, int32_t, uint32_t current_level,
+                                 bool, uint32_t& new_level) override {
+    new_level = current_level;
+    return 0;
+  }
+
+  void PullRenderData(int, int, size_t, size_t, void*, int64_t*,
+                      int64_t*) override {}
+};
