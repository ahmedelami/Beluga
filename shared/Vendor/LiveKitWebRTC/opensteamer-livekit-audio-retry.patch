+// This device never opens AVAudioSession, an AudioUnit, or physical audio I/O.
+@interface RTCRetryTestAudioDevice : NSObject <RTC_OBJC_TYPE(RTCAudioDevice)>
+@property(nonatomic, strong) id<RTC_OBJC_TYPE(RTCAudioDeviceDelegate)> delegate;
+@property(nonatomic) BOOL isInitialized;
+@property(nonatomic) BOOL isPlayoutInitialized;
+@property(nonatomic) BOOL isPlaying;
+@property(nonatomic) BOOL isRecordingInitialized;
+@property(nonatomic) BOOL isRecording;
+@property(nonatomic) NSUInteger playoutInitializations;
+@property(nonatomic) NSUInteger playoutStarts;
+@property(nonatomic) NSUInteger playoutStops;
+@property(nonatomic) NSUInteger recordingStarts;
+@property(nonatomic) NSUInteger recordingStops;
+@property(nonatomic) NSUInteger initializationFailures;
+@property(nonatomic) NSUInteger startFailures;
+@property(nonatomic) BOOL omitPlayingReadback;
+@end
+
+@implementation RTCRetryTestAudioDevice
+- (double)deviceInputSampleRate { return 48000; }
+- (NSTimeInterval)inputIOBufferDuration { return 0.01; }
+- (NSInteger)inputNumberOfChannels { return 1; }
+- (NSTimeInterval)inputLatency { return 0; }
+- (double)deviceOutputSampleRate { return 48000; }
+- (NSTimeInterval)outputIOBufferDuration { return 0.01; }
+- (NSInteger)outputNumberOfChannels { return 2; }
+- (NSTimeInterval)outputLatency { return 0; }
+
+- (BOOL)initializeWithDelegate:(id<RTC_OBJC_TYPE(RTCAudioDeviceDelegate)>)delegate {
+  self.delegate = delegate;
+  self.isInitialized = YES;
+  return YES;
+}
+
+- (BOOL)terminateDevice {
+  self.delegate = nil;
+  self.isInitialized = NO;
+  self.isPlayoutInitialized = NO;
+  self.isPlaying = NO;
+  self.isRecordingInitialized = NO;
+  self.isRecording = NO;
+  return YES;
+}
+
+- (BOOL)initializePlayout {
+  ++self.playoutInitializations;
+  if (self.initializationFailures != 0) {
+    --self.initializationFailures;
+    return NO;
+  }
+  self.isPlayoutInitialized = YES;
+  return YES;
+}
+
+- (BOOL)startPlayout {
+  ++self.playoutStarts;
+  if (self.startFailures != 0) {
+    --self.startFailures;
+    self.isPlaying = NO;
+    return NO;
+  }
+  self.isPlaying = !self.omitPlayingReadback;
+  return YES;
+}
+
+- (BOOL)stopPlayout {
+  ++self.playoutStops;
+  self.isPlaying = NO;
+  return YES;
+}
+
+- (BOOL)initializeRecording {
+  self.isRecordingInitialized = YES;
+  return YES;
+}
+
+- (BOOL)startRecording {
+  ++self.recordingStarts;
+  self.isRecording = YES;
+  return YES;
+}
+
+- (BOOL)stopRecording {
+  ++self.recordingStops;
+  self.isRecording = NO;
+  return YES;
+}
+@end
+
+namespace {
